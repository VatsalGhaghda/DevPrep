# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — get from Atlas dashboard
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ── Frontend URL (used for CORS whitelist) ────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated extra origins (e.g. staging URL)
# EXTRA_ORIGINS=https://staging.yourapp.com

# Proxy hops in front of the API (Render/Railway/nginx = 1). Defaults to 1 in
# production and false otherwise. Needed for correct per-IP rate limits.
# TRUST_PROXY=1

# ── Clerk ─────────────────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Get from Clerk dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── AI / Groq ─────────────────────────────────────────────────────────────────
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile
# Speech-to-text for voice interviews in browsers without built-in speech recognition
GROQ_STT_MODEL=whisper-large-v3-turbo

# ── Developer analytics ──
# GitHub personal access token (classic or fine-grained, no scopes needed).
# Required for the contribution calendar (GraphQL) and raises the REST limit
# from 60 to 5,000 requests/hour. Without it, GitHub activity comes from public events (90 days).
GITHUB_TOKEN=
# Optional: clist.by API credentials to list contests from other judges (AtCoder, CodeChef, ...)
CLIST_USERNAME=
CLIST_API_KEY=

# ── Code execution sandbox ───────────────────────────────────────────────────
# docker (default): every run uses a locked-down container from the
#   devprep-executor image. Build it with: npm run build:executor
# local: runs code directly on this machine with NO sandbox. Dev only; refused
#   when NODE_ENV=production unless ALLOW_UNSAFE_LOCAL_EXECUTION=true.
# Unset + NODE_ENV=development: Docker is used when available, otherwise code
#   runs locally (with a warning in the log). Set it explicitly to turn that off.
# EXECUTION_MODE=docker
# EXECUTOR_IMAGE=devprep-executor
# EXECUTOR_MEMORY=512m
# EXECUTOR_CPUS=1
# RUN_TIMEOUT_MS=5000
# COMPILE_TIMEOUT_MS=20000
# MAX_CONCURRENT_EXECUTIONS=4
# MAX_EXECUTION_QUEUE=20
# CODE_EXECUTION_RATE_LIMIT=30

# ── Secure assessment (proctoring) ────────────────────────────────────────────
# Applies to new mock interviews, MCQ quizzes and coding attempts.
# ASSESSMENT_PROCTORING=on
# ASSESSMENT_MAX_VIOLATIONS=3
# ASSESSMENT_WARNING_THRESHOLD=2
# terminate = end the assessment when the limit is reached; flag = mark it and let it continue
# ASSESSMENT_ON_EXCEED=terminate
# ASSESSMENT_FULLSCREEN_REQUIRED=true
